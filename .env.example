# Copy to .env locally. Never put keys in frontend code or commit .env.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Local development uses api_key. Azure hosting may use managed_identity.
AZURE_OPENAI_AUTH_MODE=api_key
# Optional, for a public deployment: protects model-generating endpoints.
MATCHMIND_ACCESS_TOKEN=
